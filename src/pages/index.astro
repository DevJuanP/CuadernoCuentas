---
import Base from '../layouts/Base.astro';
import ResumenDia from '../components/ResumenDia.astro';
import TablaMovimientos from '../components/TablaMovimientos.astro';
import { getUltimoSaldo } from '../db/saldos';
import { getTodosMovimientos } from '../db/movimientos';
import { getTodosCierres } from '../db/cierres';
import { calcularTablero } from '../lib/calculos';
import { formatPEN, formatFecha } from '../lib/format';

const okSaldo = Astro.url.searchParams.get('ok') === 'saldo';
const saldo = await getUltimoSaldo();
const movs = await getTodosMovimientos();
const cierres = await getTodosCierres();

const tablero = calcularTablero(
  saldo ? { efectivo: saldo.efectivoTotal, cuenta: saldo.cuenta } : null,
  movs.map((m) => ({ fecha: m.fecha, tipo: m.tipo, medio: m.medio, monto: m.monto })),
  cierres.map((c) => ({ fecha: c.fecha, efectivoContado: c.efectivoContado, cuentaContado: c.cuentaContado })),
);
---
<Base titulo="Tablero de rendición" ruta="/">
  <h1>Tablero de rendición</h1>
  {okSaldo && <p><span class="badge badge-suave">Saldo guardado</span></p>}
  {saldo ? (
    <section class="card" aria-label="Saldo inicial">
      <p class="stat-label">Saldo inicial — lunes {formatFecha(saldo.fechaEntrega ?? '2026-09-21')}</p>
      <p class="stat-valor">{formatPEN((saldo.efectivoTotal ?? 0) + saldo.cuenta)}</p>
      <p class="muted">
        Efectivo {formatPEN(saldo.efectivoTotal ?? 0)} (billetes {formatPEN(saldo.efectivoBilletes)} + monedas{' '}
        {formatPEN(saldo.efectivoMonedas)}) · Cuenta {formatPEN(saldo.cuenta)}
      </p>
      {saldo.notas && <p class="muted">{saldo.notas}</p>}
      <p class="no-print"><a class="btn btn-borde" href="/saldo-inicial">Editar saldo inicial</a></p>
    </section>
  ) : (
    <section class="card" aria-label="Sin saldo inicial">
      <p class="stat-label">Saldo inicial</p>
      <p><span class="badge badge-borde">pendiente</span></p>
      <p class="muted">Aún no registras la entrega del lunes. <a href="/saldo-inicial">Registrar saldo inicial</a></p>
    </section>
  )}
  <div id="rendicion">
    {tablero.dias.map((d) => (
      <ResumenDia resumen={d} />
    ))}
    <section class="card" aria-label="Saldo final">
      <p class="stat-label">Total final — jue {formatFecha('2026-09-24')}</p>
      <p class="stat-valor">{formatPEN(tablero.totalFinal)}</p>
    </section>
    <section class="card firmas" aria-label="Firmas de rendición">
      <p><span class="stat-label">Recibido por</span><br />___</p>
      <p><span class="stat-label">Entregado por</span><br />___</p>
    </section>
  </div>
  <TablaMovimientos movimientos={movs} bloqueado />
  <p class="no-print">
    <button type="button" class="btn btn-primario" id="btn-print">Imprimir / guardar PDF</button>{' '}
    <a class="btn btn-fantasma" href="/api/export.csv">Descargar CSV</a>
  </p>
</Base>

<script>
  document.getElementById('btn-print')?.addEventListener('click', () => window.print());
</script>

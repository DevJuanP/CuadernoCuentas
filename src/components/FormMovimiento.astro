---
import { CATEGORIAS, DIAS, MEDIOS, TIPOS, type DiaOperativo } from '../lib/const';
import { formatFecha } from '../lib/format';

interface Props {
  fecha: DiaOperativo;
  error?: string;
}

const { fecha, error = '' } = Astro.props;
---
<form method="post" class="card no-print">
  <h2>Nuevo movimiento</h2>
  {error !== '' && <p class="destructivo" role="alert">{error}</p>}
  <input type="hidden" name="action" value="crear" />
  <input type="hidden" name="fecha" value={fecha} />
  <div class="field">
    <span>Fecha</span>
    <input type="text" value={formatFecha(fecha)} disabled aria-label="Fecha del movimiento" />
  </div>
  <div class="field">
    <span>Tipo</span>
    <select name="tipo" required>
      {TIPOS.map((t) => (
        <option value={t}>{t === 'ingreso' ? 'Ingreso' : 'Gasto'}</option>
      ))}
    </select>
  </div>
  <div class="field">
    <span>Medio</span>
    <select name="medio" required>
      {MEDIOS.map((m) => (
        <option value={m}>{m === 'efectivo' ? 'Efectivo' : 'Cuenta'}</option>
      ))}
    </select>
  </div>
  <div class="field">
    <span>Categoría</span>
    <select name="categoria" required>
      {CATEGORIAS.map((c) => (
        <option value={c}>{c[0].toUpperCase() + c.slice(1)}</option>
      ))}
    </select>
  </div>
  <div class="field">
    <span>Concepto</span>
    <input type="text" name="concepto" required maxlength="120" placeholder="Ej. Almuerzos" />
  </div>
  <div class="field">
    <span>Monto (S/)</span>
    <input type="number" name="monto" min="0.01" step="0.01" required placeholder="0.00" />
  </div>
  <button type="submit" class="btn btn-primario">Registrar movimiento</button>
</form>
